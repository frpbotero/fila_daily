# Microsoft Teams Incoming Webhook URL
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/SEU-WEBHOOK-AQUI

# URL pública do serviço no Render (sem barra final)
BASE_URL=https://seu-app.onrender.com

# Fuso horário
TZ=America/Sao_Paulo

# Horário do cron (formato cron, seg-sex às 09:00 por padrão)
# CRON_DAILY=0 9 * * 1-5

# Porta (o Render define automaticamente via PORT)
# PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.k97zz9w.mongodb.net/daily-standup?appName=Cluster0

# URL pública do serviço (sem barra final)
BASE_URL=https://seu-app.onrender.com

# Fuso horário
TZ=America/Sao_Paulo

# Cron padrão para novos projetos (seg-sex às 09:00)
# CRON_DAILY=0 9 * * 1-5

# Porta (o Render define automaticamente via PORT)
# PORT=3000

# (Opcional) Webhook do Teams para criar automaticamente um projeto "Default"
# na primeira inicialização caso não exista nenhum projeto no banco.
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/SEU-WEBHOOK-AQUI
